# 상시 실행용 systemd 유닛 예시
#   1) 이 파일을 /etc/systemd/system/webrec.service 로 복사
#   2) User / WorkingDirectory / EnvironmentFile 경로를 환경에 맞게 수정
#   3) sudo systemctl daemon-reload && sudo systemctl enable --now webrec
[Unit]
Description=webrec - 예약 웹 라이브 녹화
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=recorder
WorkingDirectory=/opt/webrec
EnvironmentFile=/opt/webrec/.env
ExecStart=/usr/bin/python3 -m webrec run -c /opt/webrec/webrec.yaml
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
