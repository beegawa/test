# SMTP 설정 (source .env 후 사용하거나 systemd EnvironmentFile 로 지정)
# Gmail 예시: 2단계 인증 후 '앱 비밀번호'를 발급해서 SMTP_PASS 에 넣으세요.
export SMTP_HOST=smtp.gmail.com
export SMTP_PORT=587
export SMTP_USER=your-account@gmail.com
export SMTP_PASS=앱비밀번호16자리
export SMTP_FROM=your-account@gmail.com
export SMTP_STARTTLS=1

# Zoom 회의 암호가 있을 때
export ZOOM_PASSCODE=

# 브라우저 경로를 직접 지정하고 싶을 때
# export WEBREC_BROWSER=/usr/bin/chromium-browser
